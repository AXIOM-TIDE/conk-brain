# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/conk_brain

# ─── Optional overrides ──────────────────────────────────────────────────────
# CONK package v13 (ACTIVE) — override only if testing against a different version
CONK_PACKAGE=0x6eca0063f930674f26a4a4593a7ef5ed487e21f31caafe74290ab5df88478cc6

# Sui RPC — defaults to public mainnet endpoint
SUI_RPC=https://fullnode.mainnet.sui.io:443

# API server port
PORT=3100

# Polling interval in ms (default 30s)
POLL_INTERVAL_MS=30000

# Analytics rollup interval in ms (default 5min)
ROLLUP_INTERVAL_MS=300000

# Production flag — enables SSL for Postgres
NODE_ENV=production

# Brain's own public URL (used in discovery docs)
BRAIN_URL=https://brain.agentspark.network

# OpenAI API key — for cast embedding generation (optional for MVP)
# Embeddings power /query/similar semantic search
OPENAI_API_KEY=
